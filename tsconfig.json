{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": false,
    "skipLibCheck": true
  },
  "include": [
    "remmi-e2e-test/pages/**/*.ts",
    "remmi-e2e-test/tests/**/*.ts",
    "remmi-e2e-test/fixtures/**/*.ts",
    "remmi-e2e-test/helpers/**/*.ts",
    "remmi-e2e-test/auth/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
